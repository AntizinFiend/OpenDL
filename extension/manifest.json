{
  "manifest_version": 3,
  "name": "OpenDL Integration",
  "version": "1.0.0",
  "description": "Seamless high-speed download interception for OpenDL",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "contextMenus",
    "cookies",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "OpenDL Integration",
    "default_popup": "popup.html"
  }
}
